# Commit project skills, but keep personal state and API-key-bearing presets out of the repository.
.amrita/sessions/
.amrita/settings.json
.amrita/core.json
.amrita/mcp.json
.amrita/presets/
.amrita/*.local.json

# Build output / tooling
node_modules/
dist/
.dev-build/
.venv/
__pycache__/
*.py[cod]
.uv/
*.log
.DS_Store
.env

# Ignore the temporary LICENSE copy staged by scripts/package.sh during builds.
backend/LICENSE
